format-version: 1.2
data-version: genomind_mini_seed_2026
ontology: hp
remark: MINI SEED for offline demo + tests. For production download the real hp.obo from
  purl.obolibrary.org/obo/hp.obo and place it in data/raw/hpo/hp.obo — the same parser handles both.
remark: Some HP ids in this seed are illustrative; the loader validates format, not ID correctness.

[Term]
id: HP:0000001
name: All
def: "Root of the HPO ontology." [HPO:seed]

[Term]
id: HP:0000118
name: Phenotypic abnormality
def: "Root term for all phenotypic abnormalities." [HPO:seed]
is_a: HP:0000001 ! All

[Term]
id: HP:0000707
name: Abnormality of the nervous system
def: "An abnormality of the nervous system." [HPO:seed]
is_a: HP:0000118 ! Phenotypic abnormality

[Term]
id: HP:0001249
name: Intellectual disability
def: "Subnormal intellectual functioning originating in the developmental period." [HPO:seed]
synonym: "mental retardation" RELATED []
synonym: "dimaagi vikas mein kami" RELATED [hinglish]
is_a: HP:0000707 ! Abnormality of the nervous system

[Term]
id: HP:0001250
name: Seizures
def: "Clinical or subclinical disturbances of cerebral function caused by abnormal neuronal discharge." [HPO:seed]
synonym: "fits" RELATED []
synonym: "mirgi ka daura" RELATED [hinglish]
is_a: HP:0000707 ! Abnormality of the nervous system

[Term]
id: HP:0001252
name: Hypotonia
