{"id": "s001", "text": "Patient ko 6 mahine se haath pair mein sujan hai aur walking mushkil ho gayi hai.", "lang": "HI-EN", "entities": [{"start": 11, "end": 19, "label": "DURATION", "text": "6 mahine"}, {"start": 23, "end": 44, "label": "SYMPTOM", "text": "haath pair mein sujan"}], "offsets_repaired": true}
{"id": "s002", "text": "Bacha chhattis mahine ka hai, abhi tak bolna nahi seekha, doctor ne developmental delay bataya.", "lang": "HI-EN", "entities": [{"start": 6, "end": 24, "label": "AGE", "text": "chhattis mahine ka"}, {"start": 39, "end": 56, "label": "SYMPTOM", "text": "bolna nahi seekha"}], "offsets_repaired": true}
{"id": "s003", "text": "Peeli aankhein aur piliya do hafte se hai, liver functions disturb hain.", "lang": "HI-EN", "entities": [{"start": 0, "end": 14, "label": "SYMPTOM", "text": "Peeli aankhein"}, {"start": 19, "end": 25, "label": "SYMPTOM", "text": "piliya"}, {"start": 26, "end": 34, "label": "DURATION", "text": "do hafte"}], "offsets_repaired": true}
{"id": "s004", "text": "Kamzori badh rahi hai, pair uthane ke liye haath lagana padta hai.", "lang": "HI", "entities": [{"start": 0, "end": 7, "label": "SYMPTOM", "text": "Kamzori"}], "offsets_repaired": true}
{"id": "s005", "text": "Raat mein na dikhna shuru hua hai, night blindness ka shak hai.", "lang": "HI-EN", "entities": [{"start": 0, "end": 19, "label": "SYMPTOM", "text": "Raat mein na dikhna"}, {"start": 41, "end": 50, "label": "SYMPTOM", "text": "blindness"}], "offsets_repaired": true}
{"id": "s006", "text": "Maa bhi kamzori se pareshan hain, parivaar mein do cousins ko anemia tha.", "lang": "HI-EN", "entities": [{"start": 51, "end": 58, "label": "FAMILY_HISTORY", "text": "cousins"}], "offsets_repaired": true}
{"id": "s007", "text": "Mirgi ka daura mahine mein do baar aata hai, carbamazepine de rakhi hai.", "lang": "HI-EN", "entities": [{"start": 0, "end": 14, "label": "SYMPTOM", "text": "Mirgi ka daura"}, {"start": 45, "end": 58, "label": "DRUG", "text": "carbamazepine"}], "offsets_repaired": true}
{"id": "s008", "text": "Hemoglobin 6.5 hai, khoon ki kami ki wajah se transfusion har mahine.", "lang": "HI-EN", "entities": [{"start": 0, "end": 14, "label": "LAB_VALUE", "text": "Hemoglobin 6.5"}, {"start": 20, "end": 33, "label": "SYMPTOM", "text": "khoon ki kami"}], "offsets_repaired": true}
{"id": "s009", "text": "Chalne mein dikkat, pairon mein jhanjhanahat, neurologist se mila.", "lang": "HI", "entities": [{"start": 0, "end": 18, "label": "SYMPTOM", "text": "Chalne mein dikkat"}], "offsets_repaired": true}
{"id": "s010", "text": "Papa ko bhi same symptoms the, paternal uncle ki beti ko bhi fits.", "lang": "EN", "entities": [{"start": 40, "end": 45, "label": "FAMILY_HISTORY", "text": "uncle"}], "offsets_repaired": true}
{"id": "s011", "text": "Tili ka badhna aur jaundice repeat ho raha hai, spleen 8 cm below costal margin.", "lang": "HI-EN", "entities": [{"start": 0, "end": 14, "label": "SYMPTOM", "text": "Tili ka badhna"}, {"start": 19, "end": 27, "label": "SYMPTOM", "text": "jaundice"}], "offsets_repaired": true}
{"id": "s012", "text": "Sunai kam ho gayi hai dono kaano mein, school teacher ne notice kiya.", "lang": "HI-EN", "entities": [], "offsets_repaired": true}
{"id": "s013", "text": "Haath kaanpna table par khaana le jaate samay zyada hota hai.", "lang": "HI", "entities": [{"start": 0, "end": 13, "label": "SYMPTOM", "text": "Haath kaanpna"}], "offsets_repaired": true}
{"id": "s014", "text": "Barah saal ka larka hai par Height nahi badh rahi, yearly 2 cm only.", "lang": "HI-EN", "entities": [{"start": 28, "end": 49, "label": "SYMPTOM", "text": "Height nahi badh rahi"}], "offsets_repaired": true}
{"id": "s015", "text": "Vajan nahi badh raha, steatorrhea type motion, chest infections baar baar.", "lang": "HI-EN", "entities": [{"start": 0, "end": 20, "label": "SYMPTOM", "text": "Vajan nahi badh raha"}, {"start": 22, "end": 33, "label": "SYMPTOM", "text": "steatorrhea"}], "offsets_repaired": true}
{"id": "s016", "text": "Naye daag peeche par aaye hain, cafe-au-lait spots six hai, ganth bhi hai.", "lang": "HI-EN", "entities": [{"start": 60, "end": 65, "label": "SYMPTOM", "text": "ganth"}], "offsets_repaired": true}
{"id": "s017", "text": "Uthne ke liye haath lagata hai floor se, Gowers sign positive.", "lang": "HI-EN", "entities": [{"start": 0, "end": 30, "label": "SYMPTOM", "text": "Uthne ke liye haath lagata hai"}, {"start": 41, "end": 52, "label": "SYMPTOM", "text": "Gowers sign"}], "offsets_repaired": true}
{"id": "s018", "text": "Doctor ne phenytoin start kiya, seizures control mein aa rahe hain.", "lang": "HI-EN", "entities": [{"start": 10, "end": 19, "label": "DRUG", "text": "phenytoin"}, {"start": 32, "end": 40, "label": "SYMPTOM", "text": "seizures"}], "offsets_repaired": true}
{"id": "s019", "text": "Do saal ka bacha, hypotonia born se, head control nahi.", "lang": "EN", "entities": [{"start": 18, "end": 27, "label": "SYMPTOM", "text": "hypotonia"}], "offsets_repaired": true}
{"id": "s020", "text": "Khoon transfusion ke baad bhi HB 7 se upar nahi, spleen ka size badh raha hai.", "lang": "HI-EN", "entities": [{"start": 6, "end": 17, "label": "SYMPTOM", "text": "transfusion"}], "offsets_repaired": true}
{"id": "s021", "text": "Maa puchi thi ki cousin marriage hai, consanguineous shadi hui hai.", "lang": "HI-EN", "entities": [{"start": 17, "end": 23, "label": "FAMILY_HISTORY", "text": "cousin"}], "offsets_repaired": true}
{"id": "s022", "text": "Prescription mein clopidogrel 75mg aur atorvastatin likha gaya hai.", "lang": "HI-EN", "entities": [{"start": 18, "end": 29, "label": "DRUG", "text": "clopidogrel"}, {"start": 39, "end": 51, "label": "DRUG", "text": "atorvastatin"}], "offsets_repaired": true}
{"id": "s023", "text": "Bachche ko baar baar khaansi bukhaar ho raha hai, antibiotics se thik hota hai phir wapas.", "lang": "HI", "entities": [{"start": 11, "end": 28, "label": "SYMPTOM", "text": "baar baar khaansi"}], "offsets_repaired": true}
{"id": "s024", "text": "Eyes white nahi hain, yellowish hai do din se, urine bhi dark hai.", "lang": "EN", "entities": [{"start": 36, "end": 42, "label": "DURATION", "text": "do din"}], "offsets_repaired": true}
{"id": "s025", "text": "Sir chhota hai aur neck control 9 mahine tak nahi aaya.", "lang": "HI-EN", "entities": [{"start": 0, "end": 14, "label": "SYMPTOM", "text": "Sir chhota hai"}], "offsets_repaired": true}
