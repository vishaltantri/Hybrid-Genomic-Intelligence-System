# Environment template — copy to .env and edit.
GENOMIND_JWT_SECRET=change-me-in-production
GENOMIND_ACCESS_TOKEN_MINUTES=120

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=genomind_dev_password

POSTGRES_DSN=postgresql+psycopg://genomind:genomind_dev_password@localhost:5432/genomind
REDIS_URL=redis://localhost:6379/0

MLFLOW_TRACKING_URI=http://localhost:5000
PUBMED_API_KEY=
GENOMIND_DETERMINISTIC=1

# --- Phase 17 security ---
# development (default) | production. Production refuses a default/short JWT secret and seeds no demo users.
GENOMERA_ENV=development
# Comma separated allowed browser origins ('*' is rejected). Empty in production = no cross-origin access.
GENOMERA_CORS_ORIGINS=http://localhost:5173
# Max request body for normal routes in MB (uploads allow 25 MB).
GENOMERA_MAX_BODY_MB=2
# Production only: creates the first admin when no users exist (min 12 chars).
GENOMERA_BOOTSTRAP_ADMIN_PASSWORD=

# --- Phase 18 database ---
# sqlite only. Relative paths resolve from the repo root. Unset = data/genomind_dev.sqlite3
DATABASE_URL=
