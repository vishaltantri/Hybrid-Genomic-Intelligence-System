# Copy to .env.production. Every value here must be set deliberately; nothing is defaulted to a development value.
GENOMERA_ENV=production
# 32+ random characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GENOMIND_JWT_SECRET=
GENOMIND_ACCESS_TOKEN_MINUTES=60
# Exact browser origins that may call the API directly (https only). Leave empty when the web container proxies /api.
GENOMERA_CORS_ORIGINS=
# Creates the first admin only when the user table is empty (12+ characters). Remove after first start.
GENOMERA_BOOTSTRAP_ADMIN_PASSWORD=
DATABASE_URL=sqlite:////data/genomera.sqlite3
GENOMERA_LOG_FORMAT=json
GENOMERA_LOG_LEVEL=INFO
# Demo mode writes synthetic records into the database; leave unset in a clinical deployment.
GENOMERA_ENABLE_DEMO=
